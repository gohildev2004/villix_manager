# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret; never use NEXT_PUBLIC_ for this value
SUPABASE_SECRET_KEY=

# Environment identity
VILLIX_ENVIRONMENT=development
PAYEE_PORTAL_ORIGIN=http://localhost:3000/payee
NEXT_PUBLIC_CONTRIBUTOR_PORTAL_URL=http://localhost:3000/payee

# RazorpayX remains disabled until a test account is connected
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=
RAZORPAYX_WEBHOOK_PREVIOUS_SECRET=
RAZORPAYX_PAYOUT_MODE=NEFT
RAZORPAYX_VENDOR_PORTAL_ENABLED=false
RAZORPAYX_VENDOR_PORTAL_URL=
RAZORPAYX_DIRECT_BANK_FORM_ENABLED=false
PAYOUTS_LIVE_ENABLED=false
